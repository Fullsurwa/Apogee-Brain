# Copy this file to .env and fill in values locally.
# Do not commit .env or any real credentials.

# Required for Claude API access.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional local vault configuration.
APOGEE_VAULT_PATH=
APOGEE_ICAL_URL=

# Optional Google Calendar event-creation configuration. Keep tokens outside the vault.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_PATH=C:\Users\<user>\.config\apogee\google-calendar-token.json
GOOGLE_CALENDAR_TIMEZONE=Africa/Nairobi

# Run `npm run calendar:authorize` after setting these values to obtain the external token.

# Optional local fallback configuration.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_TIMEOUT_MS=60000

# Web dashboard port.
PORT=3000
